<Project Sdk="Microsoft.NET.Sdk">
  <!-- Claude Code／Codex 的 hook（ADR-0019 第 1 節）：主控台程式，和 App 發佈在同一個資料夾。不連網、不開 socket／named pipe -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Mac 上也能編譯（不能執行） -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RootNamespace>AIUsageMonitor.Hook</RootNamespace>
    <AssemblyName>aum-hook</AssemblyName>
    <!-- 每個 AI 事件都會啟動一次：預先編譯，縮短啟動時間 -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>false</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\UsageCore\UsageCore.csproj" />
  </ItemGroup>
</Project>
